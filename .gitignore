# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/

# Build output directories
dist/
dist-ssr/
build/

# Local configuration files
.env
.env.local
.env.*.local
.env.production
.env.stack

# Config directory env files (keep only .example)
config/.env
config/.env.local
config/.env.*.local
config/.env.vite.*
!config/.env.example

.vscode/ # VS Code specific settings (optional, if you want to ignore all of it)
!.vscode/extensions.json # Keep extensions.json if you want to share recommended extensions
.idea/ # IntelliJ IDEA specific settings
.DS_Store # macOS specific file
Thumbs.db # Windows specific file

# Editor specific files
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# Vite specific
*.local # Local Vite configuration files

# Test coverage
coverage/

# Laravel backend
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/.env.backup
!backend/.env.example
/backend/.phpunit.result.cache
/backend/storage/*.key
/backend/storage/logs/
/backend/storage/framework/cache/**
/backend/storage/framework/sessions/**
/backend/storage/framework/views/**
/backend/storage/debugbar/

# Docker volumes
/docker/mysql/
/scripts/.env.deploy

# Generated documentation (can be regenerated with: cd docs/pdf-generator && npm run generate:all)
/docs/*.pdf
/docs/*.docx
/docs/pdf-generator/*.html
/docs/pdf-generator/*.png
/docs/pdf-generator/mermaid-diagram-*.png
/docs/pdf-generator/cover-*.png
CLAUDE.md
# Paquetes de entrega armados con scripts/armar-entrega.sh: pesan gigas
# (imágenes Docker) y se regeneran desde un tag cuando hagan falta.
/dist/

# Constancias de ejecución que genera entrega/verificar.sh. Se adjuntan al acta
# de entrega en papel, no al repositorio.
/entrega/evidencia/

# Config local de asistentes/MCP (por maquina, no del proyecto)
.gemini/

# Carpetas que dejan las pruebas de carga masiva ("testing <hora>/archivo.zip")
testing */

# Previews HTML que deja el generador de PDFs (intermedios, se regeneran)
/docs/pdf-generator/*.html

# Certificados TLS del despliegue: nunca al repositorio
/entrega/ssl/
/entrega/produccion/ssl/
/entrega/produccion/.env
/entrega/produccion/backups/
