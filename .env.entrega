# Stack de ENTREGA / DEMOSTRACIÓN
# ---------------------------------------------------------------------------
# Levanta una copia aislada de la plataforma con datos de demostración, sin
# tocar tu entorno de desarrollo: proyecto de Docker distinto (-p), volúmenes
# propios y puertos altos, así que puede convivir con el stack normal
# corriendo a la vez.
#
#   docker compose -p miboleta_entrega --env-file .env.entrega up -d
#   docker compose -p miboleta_entrega --env-file .env.entrega down -v
#
# Se usa para dos cosas:
#   1. Capturar los pantallazos del manual sobre datos ficticios, para que la
#      documentación no publique nombres ni DNIs de empleados reales.
#   2. Ser la base del paquete que se entrega al cliente.

# Puertos altos para no chocar con el stack de desarrollo (8090/3308/6399/8085/8093)
MIBOLETA_HTTP_PORT=9090
MIBOLETA_MYSQL_PORT=3407
MIBOLETA_REDIS_PORT=6499
MIBOLETA_REVERB_PORT=9085
MIBOLETA_ADMINER_PORT=9091

# El frontend se compila apuntando a este stack. Sin esto, el bundle apuntaría
# al puerto del entorno de desarrollo y las llamadas irían al stack equivocado.
VITE_ENV_FILE=.env.entrega.vite

# Siembra automática en el primer arranque, con los datos de demostración
# completos (empresas, empleados en los 5 roles, boletas y vacaciones en todos
# los estados). Ver backend/database/seeders/DemoSeeder.php
RUN_SEEDERS=true
SEEDER_CLASS=Database\Seeders\DemoSeeder
