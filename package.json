      "scripts": {
            "dev": "concurrently -c \"cyan,magenta\" -n \"Laravel,Vite\" \"echo 'Laravel ya está corriendo en Docker (localhost:80)'\" \"vite\"",
            "dev:vite": "vite",
            "watch": "./watch.sh",
            "build": "vite build",
            "build:copy": "npm run build && cp -r dist/* backend/public/",
            "predeploy": "npm run build",
            "deploy": "gh-pages -d dist",
            "docker:build": "docker compose build",
            "docker:up": "docker compose up -d",
            "docker:down": "docker compose down",
            "docker:logs": "docker compose logs -f",
            "docker:restart": "docker compose restart",
            "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
            "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
            "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
            "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
            "laravel:migrate": "docker compose exec app php artisan migrate",
            "laravel:fresh": "docker compose exec app php artisan migrate:fresh --seed",
            "laravel:shell": "docker compose exec app sh",
            "laravel:cache": "docker compose exec app php artisan config:cache && docker compose exec app php artisan route:cache",
            "laravel:dev:migrate": "docker compose -f docker-compose.dev.yml exec app php artisan migrate",
            "laravel:dev:shell": "docker compose -f docker-compose.dev.yml exec app sh",
            "setup:full": "./setup.sh"
      }
