# Variables de Vite para el stack de ENTREGA (puertos 9090/9085).
# Se compilan DENTRO del bundle, así que la imagen del stack de entrega es
# distinta de la de desarrollo: apunta a sus propios puertos.
# Ninguna es secreta (viajan al navegador). Ver .env.local.example.

VITE_API_URL=http://localhost:9090/api
VITE_REVERB_APP_KEY="miboleta-key"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="9085"
VITE_REVERB_SCHEME="http"
VITE_SHOW_TEST_USERS=false
