# Variables para probar deploy localmente
# COPIA este archivo a .env.deploy y edita con tus valores reales
# cp scripts/.env.deploy.example scripts/.env.deploy
#
# IMPORTANTE: este archivo ESTÁ versionado y el repositorio es público, así que
# aquí van SOLO placeholders. Antes tenía los valores reales de host, puerto,
# usuario y huella de certificado, o sea la topología de red y dos nombres de
# usuario válidos publicados en internet. Los valores de verdad van en
# scripts/.env.deploy, que está en .gitignore.

# VPN Fortinet
VPN_HOST="TU_HOST_VPN"
VPN_PORT="TU_PUERTO_VPN"
VPN_USER="TU_USUARIO_VPN"
VPN_PASS="TU_PASSWORD_VPN"
# Huella SHA-256 del certificado del gateway (openfortivpn --trusted-cert)
VPN_CERT="TU_HUELLA_CERTIFICADO"

# SSH
SSH_HOST="TU_HOST_SSH"
SSH_PORT="TU_PUERTO_SSH"
SSH_USER="TU_USUARIO_SSH"
SSH_PASS="TU_PASSWORD_SSH"
