# ==============================================
# MIBOLETA - CONFIGURACIÓN DE PRODUCCIÓN
# ==============================================
# IMPORTANTE:
# 1. Copia este archivo a .env.production
# 2. Genera valores seguros para todas las claves
# 3. NUNCA subas este archivo con valores reales a Git
# ==============================================

# Docker Configuration
DOCKER_USERNAME=tu-usuario-dockerhub
IMAGE_TAG=latest

# Application
APP_NAME=MiBoleta
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=miboleta_prod
DB_USERNAME=miboleta_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD_456

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.tudominio.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Broadcasting - Laravel Reverb
BROADCAST_CONNECTION=reverb

# Filesystem
FILESYSTEM_DISK=local
# Para producción, considere usar S3:
# FILESYSTEM_DISK=s3

# Queue - Redis
QUEUE_CONNECTION=redis

# Cache - Redis
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_789
REDIS_PORT=6379

# Laravel Reverb (WebSockets)
REVERB_APP_ID=miboleta-prod
REVERB_APP_KEY=GENERATE_RANDOM_KEY_32_CHARS
REVERB_APP_SECRET=GENERATE_RANDOM_SECRET_64_CHARS
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite Reverb Config (Frontend)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="tudominio.com"
VITE_REVERB_PORT="8085"
VITE_REVERB_SCHEME="https"

# Mail - Configurar con tu proveedor SMTP real
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=tu_usuario_smtp
MAIL_PASSWORD=tu_password_smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (Opcional - para almacenamiento en la nube)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"

# Security
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com
SESSION_DOMAIN=.tudominio.com

# Frontend
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=https://tudominio.com/api
