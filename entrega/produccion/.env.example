# MiBoleta — configuración del servidor
# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y complétalo ANTES de ejecutar ./instalar.sh
#
#     cp .env.example .env
#     nano .env
#
# Las marcadas [OBLIGATORIO] no tienen valor por defecto razonable: si las
# dejas como están, la instalación no funcionará correctamente.
# ---------------------------------------------------------------------------

# ── Identidad del sistema ──────────────────────────────────────────────────
APP_NAME=MiBoleta
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# [OBLIGATORIO] Dirección por la que se accede al sistema, tal cual la escriben
# los usuarios en el navegador. Si usas dominio con HTTPS: https://miboleta.tuempresa.com
# Si es una IP sin certificado: http://192.168.1.50
APP_URL=http://localhost

# [OBLIGATORIO] Clave de cifrado. La genera instalar.sh si la dejas vacía.
# ⚠ Si la cambias después de tener datos, dejarán de poder descifrarse las
#   contraseñas de correo guardadas y la del certificado de firma.
APP_KEY=

# ── Imágenes ───────────────────────────────────────────────────────────────
# Las que trae el paquete. No las cambies salvo que actualices de versión.
MIBOLETA_IMAGE=ghcr.io/jorgevasquezutec/miboleta:latest
MIBOLETA_SIGNER_IMAGE=ghcr.io/jorgevasquezutec/miboleta-signer:latest

# ── Puertos publicados ─────────────────────────────────────────────────────
# Cámbialos si el servidor ya tiene algo en el 80/443.
HTTP_PORT=80
HTTPS_PORT=443
REVERB_PUBLIC_PORT=8085

# ── Base de datos ──────────────────────────────────────────────────────────
# [OBLIGATORIO] Cambia las dos contraseñas. Son locales al servidor, pero una
# contraseña por defecto en producción es una contraseña conocida.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=miboleta
DB_USERNAME=miboleta
DB_PASSWORD=CAMBIAME_clave_de_la_base
DB_ROOT_PASSWORD=CAMBIAME_clave_root_de_mysql

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Déjala vacía si Redis no se expone fuera del servidor.
REDIS_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# ── Correo saliente ────────────────────────────────────────────────────────
# [OBLIGATORIO] Sin esto no se envían avisos ni los códigos para firmar
# documentos. Este es el servidor POR DEFECTO de la plataforma; cada empresa
# puede configurar el suyo después desde la aplicación.
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=no-responder@tuempresa.com
MAIL_PASSWORD=CAMBIAME_clave_del_correo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-responder@tuempresa.com
MAIL_FROM_NAME=MiBoleta

# ── Notificaciones en tiempo real ──────────────────────────────────────────
# [OBLIGATORIO] Cambia la clave y el secreto: con los valores por defecto,
# cualquiera que conozca la dirección podría conectarse al canal.
REVERB_APP_ID=miboleta
REVERB_APP_KEY=CAMBIAME_clave_publica
REVERB_APP_SECRET=CAMBIAME_secreto
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Firma digital ──────────────────────────────────────────────────────────
SIGNER_BASE_URL=http://signer:8000
SIGNER_TIMEOUT=120

# ── Registro ───────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning
