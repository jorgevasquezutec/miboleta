# Variables de Vite (frontend). NO son secretas: Vite las incrusta en el bundle
# que se descarga el navegador, así que cualquiera con acceso a la app las ve.
# Por eso este archivo se versiona y es el que usa el Dockerfile por defecto:
# sin él, un `docker build` sobre un clon limpio falla en el COPY porque
# .env.local está en .gitignore (convención de Vite: es personal de cada dev).
#
# Uso:
#   - Docker (compose): se usa este archivo tal cual, no hay que hacer nada.
#   - `npm run dev`: cópialo a .env.local y ajusta lo que necesites.
#   - Otros valores en el build: docker build --build-arg VITE_ENV_FILE=<ruta>
#     (así es como Swarm usa config/.env.vite.swarm).

# URL del backend. Es el puerto que publica nginx en docker-compose.yml.
VITE_API_URL=http://localhost:8090/api

# Reverb (WebSockets, notificaciones en tiempo real). La APP_KEY del cliente es
# pública por diseño: identifica la app ante el servidor, no autentica nada.
# Tiene que coincidir con REVERB_APP_KEY del .env del backend.
VITE_REVERB_APP_KEY="miboleta-key"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="8085"
VITE_REVERB_SCHEME="http"

# Muestra u oculta los usuarios de prueba en la pantalla de login.
VITE_SHOW_TEST_USERS=false
