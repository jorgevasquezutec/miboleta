# Variables de Vite para Docker Swarm/Producción
# Este archivo es un TEMPLATE - Los valores reales se generan
# automáticamente desde GitHub Secrets durante el build CI/CD
#
# IMPORTANTE: NO colocar valores reales aquí
# Configurar los siguientes secrets en GitHub:
# - VITE_REVERB_APP_KEY
# - VITE_REVERB_HOST

# API Configuration - URL relativa para que funcione con cualquier IP/dominio
VITE_API_URL=/api

# WebSocket (Reverb) - Valores de ejemplo (se reemplazan en CI/CD)
VITE_REVERB_APP_KEY="SET_IN_GITHUB_SECRETS"
VITE_REVERB_HOST="SET_IN_GITHUB_SECRETS"
VITE_REVERB_PORT="80"
VITE_REVERB_SCHEME="http"
