# MiBoleta - Production Environment
# IMPORTANTE: Copiar a .env y cambiar todos los valores

APP_NAME=MiBoleta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

# ======================================
# Base de Datos
# ======================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=miboleta_prod
DB_USERNAME=miboleta
DB_PASSWORD=CAMBIAR_PASSWORD_DB

# ======================================
# Redis
# ======================================
REDIS_HOST=redis
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS
REDIS_PORT=6379
REDIS_DB=0

REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ======================================
# Drivers
# ======================================
CACHE_DRIVER=redis
CACHE_PREFIX=miboleta_cache
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# ======================================
# Email (Configurar según proveedor)
# ======================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@miboleta.com"
MAIL_FROM_NAME="${APP_NAME}"

# ======================================
# Logging
# ======================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ======================================
# Horizon (Queue Dashboard)
# ======================================
HORIZON_DOMAIN=app.miboleta.com
HORIZON_PATH=horizon
HORIZON_PREFIX=horizon:

# ======================================
# Reverb (WebSockets)
# ======================================
REVERB_APP_ID=miboleta
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ======================================
# Vite (Frontend)
# ======================================
VITE_APP_NAME="${APP_NAME}"
ASSET_URL="${APP_URL}"

# ======================================
# Docker Entrypoint
# ======================================
# Solo ejecutar seeders en primera instalación
# IMPORTANTE: Cambiar a false después de la primera instalación
RUN_SEEDERS=false
